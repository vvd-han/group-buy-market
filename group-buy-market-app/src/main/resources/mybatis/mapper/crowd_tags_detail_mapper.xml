<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.vvd.infrastructure.dao.ICrowdTagsDetailDao">

    <resultMap id="dataMap" type="com.vvd.infrastructure.dao.po.CrowdTagsDetail">
        <id column="id" property="id"/>
        <result column="tag_id" property="tagId"/>
        <result column="user_id" property="userId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="addCrowdTagsUsers">
        insert into crowd_tags_detail(tag_id, user_id)
        values
        <foreach collection="userIds" item="userId" separator=",">
            (#{tagId}, #{userId})
        </foreach>
        on duplicate key update user_id = crowd_tags_detail.user_id
    </insert>

    <select id="containsUser" timeout="2" resultType="boolean">
        select exists(select 1 from crowd_tags_detail where tag_id = #{tagId} and user_id = #{userId})
    </select>

</mapper>
